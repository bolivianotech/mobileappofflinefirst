{
  "expo": {
    "name": "Avance de Obra",
    "slug": "avance-obra",
    "scheme": "avanceobra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-image-picker", {
        "cameraPermission": "Usamos la cámara para fotografiar la evidencia del avance de obra.",
        "photosPermission": "Usamos tus fotos para adjuntar evidencia al avance de obra."
      }],
      ["expo-location", {
        "locationWhenInUsePermission": "Usamos tu ubicación para registrar dónde se realizó el avance."
      }]
    ],
    "ios": { "supportsTablet": false, "bundleIdentifier": "bo.bolivianotech.avanceobra" },
    "android": {
      "package": "bo.bolivianotech.avanceobra",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": { "favicon": "./assets/favicon.png" }
  }
}
